    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# StatsBomb Scout - Football Player Evaluation\\n\",\n",
    "    \"## Eksploracja i analiza danych\\n\",\n",
    "    \"\\n\",\n",
    "    \"Ten notebook służy do:\\n\",\n",
    "    \"1. Eksploracji danych StatsBomb\\n\",\n",
    "    \"2. Testowania preprocessing pipeline\\n\",\n",
    "    \"3. Eksperymentowania z modelami\\n\",\n",
    "    \"4. Analizy wyników\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Importy\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"\\n\",\n",
    "    \"import config\\n\",\n",
    "    \"from src.data_loader import StatsBombDataLoader\\n\",\n",
    "    \"from src.preprocessing import SequencePreprocessor\\n\",\n",
    "    \"from src.model import create_model\\n\",\n",
    "    \"from src.train import ModelTrainer\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Ustawienia\\n\",\n",
    "    \"plt.style.use('seaborn-v0_8')\\n\",\n",
    "    \"sns.set_palette('husl')\\n\",\n",
    "    \"%matplotlib inline\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Wczytanie danych\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# TODO: Wczytaj dane StatsBomb\\n\",\n",
    "    \"# Opcja 1: Z API statsbombpy\\n\",\n",
    "    \"# from statsbombpy import sb\\n\",\n",
    "    \"# events = sb.events(match_id=YOUR_MATCH_ID)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Opcja 2: Z pliku\\n\",\n",
    "    \"# loader = StatsBombDataLoader('data/raw/')\\n\",\n",
    "    \"# events = loader.load_from_json('events.json')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Dla demonstracji: dummy data\\n\",\n",
    "    \"n_events = 1000\\n\",\n",
    "    \"events = pd.DataFrame({\\n\",\n",
    "    \"    'match_id': np.random.randint(1, 10, n_events),\\n\",\n",
    "    \"    'type': np.random.choice(['Pass', 'Carry', 'Ball Receipt*', 'Shot'], n_events),\\n\",\n",
    "    \"    'player': np.random.choice(['Player A', 'Player B', 'Player C'], n_events),\\n\",\n",
    "    \"})\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Loaded {len(events)} events\\\")\\n\",\n",
    "    \"events.head()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Eksploracja danych\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Podstawowe statystyki\\n\",\n",
    "    \"print(\\\"Typy zdarzeń:\\\")\\n\",\n",
    "    \"print(events['type'].value_counts())\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Wizualizacja\\n\",\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(14, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"events['type'].value_counts().plot(kind='bar', ax=axes[0])\\n\",\n",
    "    \"axes[0].set_title('Rozkład typów zdarzeń')\\n\",\n",
    "    \"axes[0].set_xlabel('Typ zdarzenia')\\n\",\n",
    "    \"axes[0].set_ylabel('Liczba')\\n\",\n",
    "    \"\\n\",\n",
    "    \"events.groupby('player')['type'].count().plot(kind='bar', ax=axes[1])\\n\",\n",
    "    \"axes[1].set_title('Liczba zdarzeń na zawodnika')\\n\",\n",
    "    \"axes[1].set_xlabel('Zawodnik')\\n\",\n",
    "    \"axes[1].set_ylabel('Liczba zdarzeń')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Preprocessing\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Inicjalizacja preprocessora\\n\",\n",
    "    \"preprocessor = SequencePreprocessor(sequence_length=config.SEQUENCE_LENGTH)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# TODO: Implementuj preprocessing na rzeczywistych danych\\n\",\n",
    "    \"# X, y = preprocessor.prepare_dataset(events)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Dla demonstracji: dummy sequences\\n\",\n",
    "    \"n_sequences = 200\\n\",\n",
    "    \"n_features = 9\\n\",\n",
    "    \"X = np.random.randn(n_sequences, config.SEQUENCE_LENGTH, n_features)\\n\",\n",
    "    \"y = np.random.uniform(0, 0.5, n_sequences)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Shape of X: {X.shape}\\\")\\n\",\n",
    "    \"print(f\\\"Shape of y: {y.shape}\\\")\\n\",\n",
    "    \"print(f\\\"Mean xG: {y.mean():.4f}\\\")\\n\",\n",
    "    \"print(f\\\"Max xG: {y.max():.4f}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Podział danych\\n\",\n",
    "    \"X_train, X_val, X_test, y_train, y_val, y_test = preprocessor.split_data(\\n\",\n",
    "    \"    X, y, test_size=config.TEST_SPLIT, val_size=config.VALIDATION_SPLIT\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Training set: {X_train.shape}\\\")\\n\",\n",
    "    \"print(f\\\"Validation set: {X_val.shape}\\\")\\n\",\n",
    "    \"print(f\\\"Test set: {X_test.shape}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Budowa modelu\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Wybór modelu\\n\",\n",
    "    \"model_type = config.MODEL_TYPE  # 'lstm' lub 'transformer'\\n\",\n",
    "    \"input_shape = (config.SEQUENCE_LENGTH, n_features)\\n\",\n",
    "    \"\\n\",\n",
    "    \"if model_type == 'lstm':\\n\",\n",
    "    \"    model = create_model(\\n\",\n",
    "    \"        model_type='lstm',\\n\",\n",
    "    \"        input_shape=input_shape,\\n\",\n",
    "    \"        lstm_units=config.LSTM_UNITS,\\n\",\n",
    "    \"        dropout=config.LSTM_DROPOUT\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    model = create_model(\\n\",\n",
    "    \"        model_type='transformer',\\n\",\n",
    "    \"        input_shape=input_shape,\\n\",\n",
    "    \"        num_heads=config.TRANSFORMER_HEADS,\\n\",\n",
    "    \"        d_model=config.TRANSFORMER_DIM,\\n\",\n",
    "    \"        ff_dim=config.TRANSFORMER_FF_DIM,\\n\",\n",
    "    \"        num_blocks=config.TRANSFORMER_BLOCKS\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"model.summary()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. Trenowanie\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Inicjalizacja trainera\\n\",\n",
    "    \"trainer = ModelTrainer(model)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Trenowanie\\n\",\n",
    "    \"history = trainer.train(\\n\",\n",
    "    \"    X_train, y_train,\\n\",\n",
    "    \"    X_val, y_val,\\n\",\n",
    "    \"    batch_size=config.BATCH_SIZE,\\n\",\n",
    "    \"    epochs=10  # Dla eksperymentów użyj mniejszej liczby epok\\n\",\n",
    "    \")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 6. Ewaluacja\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Metryki na zbiorze testowym\\n\",\n",
    "    \"metrics = trainer.evaluate(X_test, y_test)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Wizualizacja historii trenowania\\n\",\n",
    "    \"trainer.plot_training_history()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Predykcje\\n\",\n",
    "    \"y_pred = model.predict(X_test).flatten()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Wykres predykcji vs rzeczywiste wartości\\n\",\n",
    "    \"plt.figure(figsize=(10, 6))\\n\",\n",
    "    \"plt.scatter(y_test, y_pred, alpha=0.5)\\n\",\n",
    "    \"plt.plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], 'r--', lw=2)\\n\",\n",
    "    \"plt.xlabel('Rzeczywiste xG')\\n\",\n",
    "    \"plt.ylabel('Przewidywane xG')\\n\",\n",
    "    \"plt.title('Predykcje vs Rzeczywiste wartości')\\n\",\n",
    "    \"plt.grid(True, alpha=0.3)\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Histogram błędów\\n\",\n",
    "    \"errors = y_test - y_pred\\n\",\n",
    "    \"plt.figure(figsize=(10, 6))\\n\",\n",
    "    \"plt.hist(errors, bins=30, edgecolor='black')\\n\",\n",
    "    \"plt.xlabel('Błąd predykcji')\\n\",\n",
    "    \"plt.ylabel('Częstość')\\n\",\n",
    "    \"plt.title('Rozkład błędów predykcji')\\n\",\n",
    "    \"plt.axvline(x=0, color='r', linestyle='--', linewidth=2)\\n\",\n",
    "    \"plt.grid(True, alpha=0.3)\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 7. Analiza wyników dla zawodników\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# TODO: Implementuj analizę dla poszczególnych zawodników\\n\",\n",
    "    \"# - Średnia przewidywana wartość sekwencji na zawodnika\\n\",\n",
    "    \"# - Liczba wysokowartościowych sekwencji (np. xG > 0.2)\\n\",\n",
    "    \"# - Ranking zawodników\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nAnaliza zawodników - TODO\\\")\\n\",\n",
    "    \"print(\\\"Wymagane: dodanie informacji o zawodnikach do sekwencji\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 8. Zapisywanie wyników\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Zapisz model\\n\",\n",
    "    \"trainer.save_model('notebook_model.h5')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Zapisz metryki\\n\",\n",
    "    \"trainer.save_training_metrics(metrics, 'notebook_metrics.json')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Model i metryki zapisane!\\\")\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
